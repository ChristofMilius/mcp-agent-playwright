# Ignore everything by default
*
# Whitelist: un-ignore exactly what is versioned
!.gitignore
!README.md
!LICENSE
!pyproject.toml
!uv.lock
!.python-version
!src/
!src/**
!tests/
!tests/**
!.github/
!.github/**
# Generated build/bytecode artifacts inside src stay ignored
src/**/__pycache__/
src/**/*.pyc
src/**/*.egg-info/
tests/**/__pycache__/
tests/**/*.pyc
